{
  "routes": [
    {
      "route": "/",
      "redirect": "/en/",
      "statusCode": 302
    }
  ],
  "navigationFallback": {
    "rewrite": "/404.html",
    "exclude": ["/_next/*", "/*.{png,jpg,gif,ico,svg,webp,woff,woff2,ttf,css,js}"]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "SAMEORIGIN",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
